// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Enums for predefined values
enum UserRole {
  STAFF
  SUPERVISOR
  ADMIN
}

enum EmploymentStatus {
  PNS
  PPPK
}

enum AttendanceStatus {
  PRESENT
  LATE
  EARLY_LEAVE
  ABSENT
  LEAVE
  SICK
}

enum PeriodType {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}


model User {
  id                String           @id @default(uuid(7))
  nip               String           @unique
  name              String
  email             String           @unique
  password          String
  role              UserRole         @default(STAFF)
  work_unit         String?
  position          String?
  grade             String?
  employment_status EmploymentStatus?
  supervisor_id     String?
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt

  // Relations
  supervisor          User?                @relation("UserSupervisor", fields: [supervisor_id], references: [id])
  subordinates        User[]               @relation("UserSupervisor")
  attendances         Attendance[]
  skp_items           SkpItem[]
  performance_reports PerformanceReport[]
  approvals           Approval[]

  @@map("users")
}

model Attendance {
  id              String           @id @default(uuid(7))
  user_id         String
  attendance_date DateTime         @db.Date
  check_in        DateTime?
  check_out       DateTime?
  status          AttendanceStatus @default(PRESENT)
  location_data   Json?
  photo_url       String?
  created_at      DateTime         @default(now())

  // Relations
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, attendance_date])
  @@index([attendance_date])
  @@map("attendances")
}

model SkpItem {
  id          String   @id @default(uuid(7))
  user_id     String
  year        Int
  no          Int
  indicator   String
  action_plan String
  target      String
  unit        String?
  weight      Decimal? @default(0) @db.Decimal(5, 2)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  // Relations
  user             User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  skp_realizations SkpRealization[]

  @@index([user_id, year])
  @@map("skp_items")
}

model SkpRealization {
  id                  String   @id @default(uuid(7))
  skp_item_id         String
  realization         String?
  progress_percentage Decimal? @default(0) @db.Decimal(5, 2)
  evidence_files      Json     @default("[]")
  notes               String?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  // Relations
  skp_item SkpItem @relation(fields: [skp_item_id], references: [id], onDelete: Cascade)

  @@index([skp_item_id])
  @@map("skp_realizations")
}

model PerformanceReport {
  id                 String       @id @default(uuid(7))
  user_id            String
  period_type        PeriodType
  start_date         DateTime     @db.Date
  end_date           DateTime     @db.Date
  attendance_summary Json         @default("{}")
  skp_summary        Json         @default("{}")
  total_score        Decimal?     @default(0) @db.Decimal(5, 2)
  status             ReportStatus @default(DRAFT)
  created_at         DateTime     @default(now())
  updated_at         DateTime     @updatedAt

  // Relations
  user      User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  approvals Approval[]

  @@index([user_id])
  @@index([start_date, end_date])
  @@map("performance_reports")
}

model Approval {
  id          String         @id @default(uuid(7))
  report_id   String
  approver_id String
  status      ApprovalStatus @default(PENDING)
  comments    String?
  approved_at DateTime?
  created_at  DateTime       @default(now())

  // Relations
  report   PerformanceReport @relation(fields: [report_id], references: [id], onDelete: Cascade)
  approver User              @relation(fields: [approver_id], references: [id])

  @@index([report_id])
  @@index([approver_id])
  @@map("approvals")
}
