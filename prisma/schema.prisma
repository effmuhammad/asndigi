// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Enums for predefined values
enum UserRole {
  STAFF
  SUPERVISOR
  ADMIN
}

enum EmploymentStatus {
  PNS
  PPPK
}

enum AttendanceStatus {
  PRESENT
  LATE
  EARLY_LEAVE
  ABSENT
  LEAVE
  SICK
}

enum PeriodType {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SkpMonthlyStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}


model User {
  id                String           @id @default(uuid(7))
  nip               String           @unique
  name              String
  email             String           @unique
  password          String
  role              UserRole         @default(STAFF)
  work_unit         String?
  position          String?
  grade             String?
  employment_status EmploymentStatus?
  supervisor_id     String?
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt

  // Relations
  supervisor          User?                @relation("UserSupervisor", fields: [supervisor_id], references: [id])
  subordinates        User[]               @relation("UserSupervisor")
  attendances         Attendance[]
  performance_reports PerformanceReport[]
  approvals           Approval[]
  skp_monthly_entries SkpMonthlyEntry[]
  created_skp_monthly SkpMonthlyEntry[]    @relation("SkpMonthlyCreator")
  supervised_skp_monthly SkpMonthlyEntry[] @relation("SkpMonthlySupervisor")

  @@map("users")
}

model Attendance {
  id              String           @id @default(uuid(7))
  user_id         String
  attendance_date DateTime         @db.Date
  check_in        DateTime?
  check_out       DateTime?
  status          AttendanceStatus @default(PRESENT)
  location_data   Json?
  photo_url       String?
  created_at      DateTime         @default(now())

  // Relations
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, attendance_date])
  @@index([attendance_date])
  @@map("attendances")
}



model PerformanceReport {
  id                 String       @id @default(uuid(7))
  user_id            String
  period_type        PeriodType
  start_date         DateTime     @db.Date
  end_date           DateTime     @db.Date
  attendance_summary Json         @default("{}")
  skp_summary        Json         @default("{}")
  total_score        Decimal?     @default(0) @db.Decimal(5, 2)
  status             ReportStatus @default(DRAFT)
  created_at         DateTime     @default(now())
  updated_at         DateTime     @updatedAt

  // Relations
  user      User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  approvals Approval[]

  @@index([user_id])
  @@index([start_date, end_date])
  @@map("performance_reports")
}

model Approval {
  id          String         @id @default(uuid(7))
  report_id   String
  approver_id String
  status      ApprovalStatus @default(PENDING)
  comments    String?
  approved_at DateTime?
  created_at  DateTime       @default(now())

  // Relations
  report   PerformanceReport @relation(fields: [report_id], references: [id], onDelete: Cascade)
  approver User              @relation(fields: [approver_id], references: [id])

  @@index([report_id])
  @@index([approver_id])
  @@map("approvals")
}

model WorkSettings {
  id                      String   @id @default(uuid(7))
  work_start_time         String   @default("08:00") // Format HH:mm
  work_end_time           String   @default("17:00") // Format HH:mm
  late_tolerance_minutes  Int      @default(0)
  is_active              Boolean  @default(true)
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  @@index([is_active])
  @@map("work_settings")
}

model SkpMonthlyEntry {
  id                 String            @id @default(uuid(7))
  user_id            String
  month              Int               // 1-12
  year               Int
  sequence_no        Int               @default(1)
  indicator          String
  action_plan        String
  target_realization String
  supporting_data    String?
  feedback           String?
  status             SkpMonthlyStatus  @default(DRAFT)
  created_at         DateTime          @default(now())
  updated_at         DateTime          @updatedAt
  created_by         String?
  supervisor_id      String?

  // Relations
  user       User                @relation(fields: [user_id], references: [id], onDelete: Cascade)
  creator    User?               @relation("SkpMonthlyCreator", fields: [created_by], references: [id])
  supervisor User?               @relation("SkpMonthlySupervisor", fields: [supervisor_id], references: [id])
  files      SkpMonthlyFile[]

  @@unique([user_id, year, month, sequence_no])
  @@index([user_id])
  @@index([year, month])
  @@index([status])
  @@index([supervisor_id])
  @@map("skp_monthly_entries")
}

model SkpMonthlyFile {
  id            String           @id @default(uuid(7))
  entry_id      String
  file_name     String
  original_name String
  file_path     String
  file_type     String?
  file_size     Int?
  uploaded_at   DateTime         @default(now())

  // Relations
  entry SkpMonthlyEntry @relation(fields: [entry_id], references: [id], onDelete: Cascade)

  @@index([entry_id])
  @@index([uploaded_at])
  @@map("skp_monthly_files")
}
