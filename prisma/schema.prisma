// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Enums for predefined values
enum UserRole {
  STAFF
  SUPERVISOR
  ADMIN
}

enum EmploymentStatus {
  PNS
  PPPK
}

enum AttendanceStatus {
  PRESENT
  LATE
  EARLY_LEAVE
  ABSENT
  LEAVE
  SICK
}

enum PeriodType {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SkpMonthlyStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum SkType {
  PENGANGKATAN
  MUTASI
  PROMOSI
  PEMBERHENTIAN
}

enum TrainingCategory {
  TEKNIS
  MANAJERIAL
  SOSIAL_KULTURAL
  FUNGSIONAL
  KEPEMIMPINAN
}

enum OrganizationalPredicate {
  SANGAT_BAIK
  BAIK
  CUKUP
  KURANG
}

enum WorkResultRating {
  DIATAS_EKSPEKTASI
  SESUAI_EKSPEKTASI
  DIBAWAH_EKSPEKTASI
}

enum BehaviorRating {
  DIATAS_EKSPEKTASI
  SESUAI_EKSPEKTASI
  DIBAWAH_EKSPEKTASI
}

enum PerformancePredicate {
  SANGAT_BAIK
  BAIK
  KURANG
}

enum DigitalSignatureStatus {
  PENDING
  SIGNED
  REJECTED
}


model User {
  id                String           @id @default(uuid(7))
  nip               String           @unique
  name              String
  email             String           @unique
  password          String
  role              UserRole         @default(STAFF)
  work_unit         String?
  position          String?
  grade             String?
  employment_status EmploymentStatus?
  supervisor_id     String?
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt

  // Relations
  supervisor          User?                @relation("UserSupervisor", fields: [supervisor_id], references: [id])
  subordinates        User[]               @relation("UserSupervisor")
  attendances         Attendance[]
  performance_reports PerformanceReport[]
  approvals           Approval[]
  skp_monthly_entries SkpMonthlyEntry[]
  created_skp_monthly SkpMonthlyEntry[]    @relation("SkpMonthlyCreator")
  supervised_skp_monthly SkpMonthlyEntry[] @relation("SkpMonthlySupervisor")
  skp_monthly_behaviors SkpMonthlyBehavior[]
  created_skp_behaviors SkpMonthlyBehavior[] @relation("SkpBehaviorCreator")
  supervised_skp_behaviors SkpMonthlyBehavior[] @relation("SkpBehaviorSupervisor")
  profile             Profile?
  created_organizational_reports OrganizationalPerformanceReport[] @relation("OrganizationalReportCreator")
  annual_performance_reports AnnualPerformanceReport[]
  supervisor_evaluations SupervisorEvaluation[] @relation("SupervisorEvaluationSupervisor")
  received_evaluations SupervisorEvaluation[] @relation("SupervisorEvaluationEmployee")
  digital_signatures DigitalSignature[]
  
  @@map("users")
}

model Attendance {
  id              String           @id @default(uuid(7))
  user_id         String
  attendance_date DateTime         @db.Date
  check_in        DateTime?
  check_out       DateTime?
  status          AttendanceStatus @default(PRESENT)
  location_data   Json?
  photo_url       String?
  created_at      DateTime         @default(now())

  // Relations
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, attendance_date])
  @@index([attendance_date])
  @@map("attendances")
}

model PerformanceReport {
  id                 String       @id @default(uuid(7))
  user_id            String
  period_type        PeriodType
  start_date         DateTime     @db.Date
  end_date           DateTime     @db.Date
  attendance_summary Json         @default("{}")
  skp_summary        Json         @default("{}")
  total_score        Decimal?     @default(0) @db.Decimal(5, 2)
  status             ReportStatus @default(DRAFT)
  created_at         DateTime     @default(now())
  updated_at         DateTime     @updatedAt

  // Relations
  user      User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  approvals Approval[]

  @@index([user_id])
  @@index([start_date, end_date])
  @@map("performance_reports")
}

model Approval {
  id          String         @id @default(uuid(7))
  report_id   String
  approver_id String
  status      ApprovalStatus @default(PENDING)
  comments    String?
  approved_at DateTime?
  created_at  DateTime       @default(now())

  // Relations
  report   PerformanceReport @relation(fields: [report_id], references: [id], onDelete: Cascade)
  approver User              @relation(fields: [approver_id], references: [id])

  @@index([report_id])
  @@index([approver_id])
  @@map("approvals")
}

model WorkSettings {
  id                      String   @id @default(uuid(7))
  work_start_time         String   @default("08:00") // Format HH:mm
  work_end_time           String   @default("17:00") // Format HH:mm
  late_tolerance_minutes  Int      @default(0)
  is_active              Boolean  @default(true)
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  @@index([is_active])
  @@map("work_settings")
}

model SkpMonthlyEntry {
  id                 String            @id @default(uuid(7))
  user_id            String
  month              Int               // 1-12
  year               Int
  sequence_no        Int               @default(1)
  indicator          String
  action_plan        String
  target_realization String
  supporting_data    String?
  supporting_data_submission_date DateTime? @db.Date
  feedback           String?
  status             SkpMonthlyStatus  @default(DRAFT)
  created_at         DateTime          @default(now())
  updated_at         DateTime          @updatedAt
  created_by         String?
  supervisor_id      String?

  // Relations
  user       User                @relation(fields: [user_id], references: [id], onDelete: Cascade)
  creator    User?               @relation("SkpMonthlyCreator", fields: [created_by], references: [id])
  supervisor User?               @relation("SkpMonthlySupervisor", fields: [supervisor_id], references: [id])
  files      SkpMonthlyFile[]

  @@unique([user_id, year, month, sequence_no])
  @@index([user_id])
  @@index([year, month])
  @@index([status])
  @@index([supervisor_id])
  @@map("skp_monthly_entries")
}

model SkpMonthlyFile {
  id            String           @id @default(uuid(7))
  entry_id      String
  file_name     String
  original_name String
  file_path     String
  file_type     String?
  file_size     Int?
  uploaded_at   DateTime         @default(now())

  // Relations
  entry SkpMonthlyEntry @relation(fields: [entry_id], references: [id], onDelete: Cascade)

  @@index([entry_id])
  @@index([uploaded_at])
  @@map("skp_monthly_files")
}

model SkpMonthlyBehavior {
  id                 String            @id @default(uuid(7))
  user_id            String
  month              Int               // 1-12
  year               Int
  sequence_no        Int               @default(1)
  behavior           String            // Main variable: Perilaku
  feedback           String?           // Main variable: Feedback
  behavior_category  String?           // Supporting variable: kategori perilaku
  assessment_score   Int?              // Supporting variable: skor penilaian (1-5)
  improvement_notes  String?           // Supporting variable: catatan perbaikan
  status             SkpMonthlyStatus  @default(DRAFT)
  created_at         DateTime          @default(now())
  updated_at         DateTime          @updatedAt
  created_by         String?
  supervisor_id      String?

  // Relations
  user       User                @relation(fields: [user_id], references: [id], onDelete: Cascade)
  creator    User?               @relation("SkpBehaviorCreator", fields: [created_by], references: [id])
  supervisor User?               @relation("SkpBehaviorSupervisor", fields: [supervisor_id], references: [id])

  @@unique([user_id, year, month, sequence_no])
  @@index([user_id])
  @@index([year, month])
  @@index([status])
  @@index([supervisor_id])
  @@map("skp_monthly_behaviors")
}

model Profile {
  id                    String    @id @default(uuid(7))
  user_id               String    @unique
  full_name             String?
  birth_place           String?
  birth_date            DateTime? @db.Date
  gender                String?
  religion              String?
  marital_status        String?
  address               String?
  phone                 String?
  emergency_contact     String?
  emergency_phone       String?
  photo_url             String?
  education_level       String?
  education_institution String?
  education_major       String?
  education_year        Int?
  employment_start_date DateTime? @db.Date
  years_of_service      Int?
  skills                Json      @default("[]")
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  // Relations
  user            User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  sk_history      SkHistory[]
  training_records TrainingRecord[]

  @@index([user_id])
  @@map("profiles")
}

model SkHistory {
  id          String   @id @default(uuid(7))
  profile_id  String
  sk_number   String
  sk_type     SkType
  position    String
  unit        String
  effective_date DateTime @db.Date
  file_url    String?
  description String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  // Relations
  profile Profile @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@index([profile_id])
  @@index([effective_date])
  @@map("sk_history")
}

model TrainingRecord {
  id               String            @id @default(uuid(7))
  profile_id       String
  training_name    String
  category         TrainingCategory
  organizer        String
  start_date       DateTime          @db.Date
  end_date         DateTime          @db.Date
  duration_hours   Int?
  certificate_url  String?
  description      String?
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt

  // Relations
  profile Profile @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@index([profile_id])
  @@index([start_date])
  @@index([category])
  @@map("training_records")
}

model OrganizationalPerformanceReport {
  id                        String                   @id @default(uuid(7))
  year                      Int
  total_employees           Int
  average_attendance_rate   Decimal                  @db.Decimal(5, 2)
  average_skp_progress      Decimal                  @db.Decimal(5, 2)
  overall_performance_score Decimal                  @db.Decimal(5, 2)
  predicate                 OrganizationalPredicate
  summary                   String?
  recommendations           String?
  created_at                DateTime                 @default(now())
  updated_at                DateTime                 @updatedAt
  created_by                String?

  // Relations
  creator User? @relation("OrganizationalReportCreator", fields: [created_by], references: [id])

  @@unique([year])
  @@index([year])
  @@index([predicate])
  @@map("organizational_performance_reports")
}

model AnnualPerformanceReport {
  id                        String                   @id @default(uuid(7))
  user_id                   String
  year                      Int
  attendance_summary        Json                     @default("{}")
  skp_summary              Json                     @default("{}")
  work_result_rating       WorkResultRating
  behavior_rating          BehaviorRating
  performance_predicate    PerformancePredicate
  ai_generated_summary     String?
  self_assessment          String?
  achievements             String?
  challenges               String?
  improvement_plan         String?
  status                   ReportStatus             @default(DRAFT)
  submitted_at             DateTime?
  approved_at              DateTime?
  created_at               DateTime                 @default(now())
  updated_at               DateTime                 @updatedAt

  // Relations
  user                     User                     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  supervisor_evaluation    SupervisorEvaluation?
  digital_signature        DigitalSignature?

  @@unique([user_id, year])
  @@index([user_id])
  @@index([year])
  @@index([status])
  @@index([performance_predicate])
  @@map("annual_performance_reports")
}

model SupervisorEvaluation {
  id                       String                   @id @default(uuid(7))
  annual_report_id         String                   @unique
  supervisor_id            String
  employee_id              String
  work_quality_score       Int                      // 1-5 scale
  work_quantity_score      Int                      // 1-5 scale
  punctuality_score        Int                      // 1-5 scale
  cooperation_score        Int                      // 1-5 scale
  initiative_score         Int                      // 1-5 scale
  leadership_score         Int?                     // 1-5 scale (optional for non-leadership roles)
  overall_rating           Decimal                  @db.Decimal(3, 2)
  supervisor_comments      String?
  recommendations          String?
  development_areas        String?
  strengths                String?
  created_at               DateTime                 @default(now())
  updated_at               DateTime                 @updatedAt

  // Relations
  annual_report            AnnualPerformanceReport  @relation(fields: [annual_report_id], references: [id], onDelete: Cascade)
  supervisor               User                     @relation("SupervisorEvaluationSupervisor", fields: [supervisor_id], references: [id])
  employee                 User                     @relation("SupervisorEvaluationEmployee", fields: [employee_id], references: [id])

  @@index([supervisor_id])
  @@index([employee_id])
  @@index([annual_report_id])
  @@map("supervisor_evaluations")
}

model DigitalSignature {
  id                       String                   @id @default(uuid(7))
  annual_report_id         String                   @unique
  signer_id                String
  signature_data           String                   // Base64 encoded signature or hash
  signature_timestamp      DateTime
  ip_address               String?
  user_agent               String?
  status                   DigitalSignatureStatus   @default(PENDING)
  verification_code        String?
  expires_at               DateTime?
  created_at               DateTime                 @default(now())

  // Relations
  annual_report            AnnualPerformanceReport  @relation(fields: [annual_report_id], references: [id], onDelete: Cascade)
  signer                   User                     @relation(fields: [signer_id], references: [id])

  @@index([signer_id])
  @@index([annual_report_id])
  @@index([status])
  @@index([signature_timestamp])
  @@map("digital_signatures")
}
